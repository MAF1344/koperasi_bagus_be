PORT=5000
NODE_ENV=development

# Supabase Connection
# Gunakan DATABASE_URL (Transaction Mode) dari Supabase Settings > Database
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Atau gunakan variabel individual jika DATABASE_URL tidak tersedia
DB_HOST=your-project-id.supabase.co
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=postgres
DB_PORT=5432

# JWT & Other
JWT_SECRET=your_jwt_secret
CLIENT_URL=http://localhost:5173
