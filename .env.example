PORT=5000
NODE_ENV=development

# Pilih profil database yang aktif:
# - local = PostgreSQL lokal via pgAdmin
# - supabase = koneksi cloud/Supabase
DB_PROFILE=local

# --- Konfigurasi Lokal (pgAdmin / PostgreSQL lokal) ---
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=your_local_password
LOCAL_DB_NAME=koperasi_bagus
LOCAL_DATABASE_URL=postgresql://postgres:your_local_password@localhost:5432/koperasi_bagus

# --- Konfigurasi Cloud / Supabase ---
CLOUD_DB_HOST=your-project.supabase.co
CLOUD_DB_PORT=5432
CLOUD_DB_USER=postgres
CLOUD_DB_PASSWORD=your_supabase_password
CLOUD_DB_NAME=postgres
CLOUD_DATABASE_URL=postgresql://postgres:your_supabase_password@your-project.supabase.co:5432/postgres

# JWT & Other
JWT_SECRET=your_jwt_secret
CLIENT_URL=http://localhost:5173
